<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- LIST: Dedicated workout members list (not touching core)      -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_fitness_membership_members_list">
        <field name="name">fitness.membership.members.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="membership_state" string="State" widget="badge"
                       decoration-info="membership_state == 'waiting'"
                       decoration-success="membership_state in ['invoiced', 'free', 'paid']"/>
                <field name="membership_start" string="Start date"/>
                <field name="membership_stop" string="End date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="%(action_fitness_membership_member_plans)d"
                        type="action"
                        string="Workouts"
                        icon="fa-dumbbell"
                        class="btn-link"
                        context="{'active_id': id, 'target_partner_id': id, 'default_target_partner_id': id}"
                />
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST: WGER-style Templates list (Name, Start, End, Duration, State, Origin) -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_fitness_membership_template_list_wger">
        <field name="name">fitness.workout.plan.membership.template.list.wger</field>
        <field name="model">fitness.workout.plan</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="start"/>
                <field name="end"/>
                <field name="duration_text" string="Duration"/>
                <field name="state"/>
                <field name="origin_template_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Pin WGER-style list view to the Templates action -->
    <record model="ir.actions.act_window.view" id="action_fitness_membership_templates_view_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fitness_membership_template_list_wger"/>
        <field name="act_window_id" ref="fitness_workout.action_fitness_workout_templates"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_fitness_membership_templates_view_form">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="fitness_workout.action_fitness_workout_templates"/>
    </record>

    <!-- ============================================================ -->
    <!-- LIST: Template list with Assign Selected button               -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_fitness_membership_template_list">
        <field name="name">fitness.workout.plan.membership.template.list</field>
        <field name="model">fitness.workout.plan</field>
        <field name="arch" type="xml">
            <list limit="80" create="false" delete="false">
                <header>
                    <button name="action_assign_selected_to_member" type="object"
                            string="Assign Selected" class="btn-primary"
                            groups="fitness_workout.group_workout_trainer,fitness_workout.group_workout_manager"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="start"/>
                <field name="end"/>
                <field name="duration_text" string="Duration"/>
                <field name="state"/>
                <field name="is_public"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST: Member workouts with Assign button                      -->
    <!-- ============================================================ -->
    <record model="ir.ui.view" id="view_fitness_membership_member_plans_list">
        <field name="name">fitness.workout.plan.membership.member.plans.list</field>
        <field name="model">fitness.workout.plan</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <header>
                    <button name="action_assign_templates_to_member" type="object"
                            string="Assign" class="btn-primary"
                            groups="fitness_workout.group_workout_trainer,fitness_workout.group_workout_manager"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="start"/>
                <field name="end"/>
                <field name="state"/>
                <field name="origin_template_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION: Member's assigned workout plans                       -->
    <!-- ============================================================ -->
    <record model="ir.actions.act_window" id="action_fitness_membership_member_plans">
        <field name="name">Workout Plans</field>
        <field name="res_model">fitness.workout.plan</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_fitness_membership_member_plans_list"/>
        <field name="domain">[('plan_scope', '=', 'user'), ('partner_id', '=', active_id)]</field>
        <field name="context">{'create': False, 'target_partner_id': active_id, 'default_target_partner_id': active_id}</field>
    </record>

    <record model="ir.actions.act_window.view" id="action_fitness_membership_member_plans_view_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fitness_membership_member_plans_list"/>
        <field name="act_window_id" ref="action_fitness_membership_member_plans"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_fitness_membership_member_plans_view_form">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_fitness_membership_member_plans"/>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION: Assign templates (template list with search)          -->
    <!-- ============================================================ -->
    <record model="ir.actions.act_window" id="action_fitness_membership_assign_templates">
        <field name="name">Assign Workout Plans</field>
        <field name="res_model">fitness.workout.plan</field>
        <field name="view_mode">list</field>
        <field name="domain">[('plan_scope', '=', 'template')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION: Members list-first (workout members, not core)        -->
    <!-- ============================================================ -->
    <record model="ir.actions.act_window" id="action_fitness_membership_members">
        <field name="name">Members</field>
        <field name="path">workout-members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="membership.view_res_partner_member_filter"/>
        <field name="domain">[('membership_state', 'in', ['invoiced', 'paid', 'free'])]</field>
        <field name="context">{'search_default_all_members': 1}</field>
    </record>

    <record model="ir.actions.act_window.view" id="action_fitness_membership_members_view_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fitness_membership_members_list"/>
        <field name="act_window_id" ref="action_fitness_membership_members"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_fitness_membership_members_view_form">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_fitness_membership_members"/>
    </record>

    <!-- ============================================================ -->
    <!-- MENU: Workout > Members                                       -->
    <!-- ============================================================ -->
    <menuitem
        id="menu_fitness_membership_members"
        name="Members"
        parent="fitness_workout.menu_workout_root"
        action="action_fitness_membership_members"
        sequence="35"
    />

</odoo>
