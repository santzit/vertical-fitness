<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_media_tree" model="ir.ui.view">
        <field name="name">fitness.media.tree</field>
        <field name="model">fitness.media</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mimetype"/>
                <field name="file_size"/>
                <field name="media_kind"/>
                <field name="source_type"/>
                <field name="source_url"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_media_form" model="ir.ui.view">
        <field name="name">fitness.media.form</field>
        <field name="model">fitness.media</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="media_kind"/>
                            <field name="source_type"/>
                            <field name="source_url"/>
                            <field name="external_uid"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="datas" widget="image" class="oe_avatar"/>
                            <field name="mimetype" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                            <field name="checksum" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
