<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_dashboard_fitness_workout" model="spreadsheet.dashboard">
        <field name="name">Workout</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="fitness_workout_dashboard/data/files/workout_dashboard.json"
        />
        <field
            name="sample_dashboard_file_path"
        >fitness_workout_dashboard/data/files/workout_dashboard.json</field>
        <field
            name="main_data_model_ids"
            eval="[(4, ref('fitness_workout.model_fitness_workout_plan')), (4, ref('fitness_workout.model_fitness_workout_card'))]"
        />
        <field name="dashboard_group_id" ref="fitness_workout_dashboard.spreadsheet_dashboard_group_workout"/>
        <field
            name="group_ids"
            eval="[Command.link(ref('fitness_workout.group_workout_trainer')), Command.link(ref('fitness_workout.group_workout_manager'))]"
        />
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>
</odoo>
