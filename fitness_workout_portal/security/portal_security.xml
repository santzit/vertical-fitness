<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="portal_fitness_workout_plan_rule" model="ir.rule">
        <field name="name">Portal: own routines only</field>
        <field name="model_id" ref="fitness_workout.model_fitness_workout_plan" />
        <field name="domain_force">
            ['|',
                '&amp;', ('plan_scope', '=', 'template'), ('is_public', '=', True),
                ('partner_id', '=', user.partner_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    </record>

