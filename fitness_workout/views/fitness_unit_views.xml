<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_repetition_unit_tree" model="ir.ui.view">
        <field name="name">fitness.repetition.unit.tree</field>
        <field name="model">fitness.repetition.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_repetition_unit_form" model="ir.ui.view">
        <field name="name">fitness.repetition.unit.form</field>
        <field name="model">fitness.repetition.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="unit_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_repetition_unit" model="ir.actions.act_window">
        <field name="name">Repetition Units</field>
        <field name="res_model">fitness.repetition.unit</field>
        <field name="view_mode">list,form</field>
        <field name="path">repetition-unit</field>
    </record>

    <record id="view_fitness_weight_unit_tree" model="ir.ui.view">
        <field name="name">fitness.weight.unit.tree</field>
        <field name="model">fitness.weight.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_weight_unit_form" model="ir.ui.view">
        <field name="name">fitness.weight.unit.form</field>
        <field name="model">fitness.weight.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_weight_unit" model="ir.actions.act_window">
        <field name="name">Weight Units</field>
        <field name="res_model">fitness.weight.unit</field>
        <field name="view_mode">list,form</field>
        <field name="path">weight-unit</field>
    </record>
</odoo>
