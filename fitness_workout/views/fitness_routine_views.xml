<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_routine_tree" model="ir.ui.view">
        <field name="name">fitness.routine.tree</field>
        <field name="model">fitness.routine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start"/>
                <field name="end"/>
                <field name="is_template"/>
                <field name="is_public"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_routine_search" model="ir.ui.view">
        <field name="name">fitness.routine.search</field>
        <field name="model">fitness.routine</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Templates" name="template" domain="[('is_template', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fitness_routine_form" model="ir.ui.view">
        <field name="name">fitness.routine.form</field>
        <field name="model">fitness.routine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="start"/>
                            <field name="end"/>
                        </group>
                        <group>
                            <field name="is_template"/>
                            <field name="is_public"/>
                            <field name="fit_in_week"/>
                            <field name="active"/>
                            <field name="uuid" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Days">
                            <field name="day_ids">
                                <list editable="bottom">
                                    <field name="order"/>
                                    <field name="name"/>
                                    <field name="day_type"/>
                                    <field name="is_rest"/>
                                </list>
                            </field>
                        </page>
                        <page string="Labels">
                            <field name="label_ids">
                                <list editable="bottom">
                                    <field name="start_offset"/>
                                    <field name="end_offset"/>
                                    <field name="label_text"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fitness_routine" model="ir.actions.act_window">
        <field name="name">Workout Plans</field>
        <field name="res_model">fitness.routine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitness_routine_search"/>
    </record>

    <record id="view_fitness_day_tree" model="ir.ui.view">
        <field name="name">fitness.day.tree</field>
        <field name="model">fitness.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="routine_id"/>
                <field name="order"/>
                <field name="name"/>
                <field name="day_type"/>
                <field name="is_rest"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_day_form" model="ir.ui.view">
        <field name="name">fitness.day.form</field>
        <field name="model">fitness.day</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="routine_id"/>
                        <field name="order"/>
                        <field name="name"/>
                        <field name="day_type"/>
                        <field name="is_rest"/>
                        <field name="need_logs_to_advance"/>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Slots">
                            <field name="slot_ids">
                                <list editable="bottom">
                                    <field name="order"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_day" model="ir.actions.act_window">
        <field name="name">Workout Plan Days</field>
        <field name="res_model">fitness.day</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fitness_slot_tree" model="ir.ui.view">
        <field name="name">fitness.slot.tree</field>
        <field name="model">fitness.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="routine_id"/>
                <field name="day_id"/>
                <field name="order"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_slot_form" model="ir.ui.view">
        <field name="name">fitness.slot.form</field>
        <field name="model">fitness.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="day_id"/>
                        <field name="order"/>
                        <field name="comment"/>
                    </group>
                    <field name="entry_ids">
                        <list editable="bottom">
                            <field name="order"/>
                            <field name="exercise_id"/>
                            <field name="exercise_type"/>
                            <field name="repetition_unit_id"/>
                            <field name="weight_unit_id"/>
                            <field name="comment"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_slot" model="ir.actions.act_window">
        <field name="name">Workout Plan Slots</field>
        <field name="res_model">fitness.slot</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fitness_slot_entry_tree" model="ir.ui.view">
        <field name="name">fitness.slot.entry.tree</field>
        <field name="model">fitness.slot.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="routine_id"/>
                <field name="slot_id"/>
                <field name="order"/>
                <field name="exercise_id"/>
                <field name="exercise_type"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_slot_entry_form" model="ir.ui.view">
        <field name="name">fitness.slot.entry.form</field>
        <field name="model">fitness.slot.entry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="slot_id"/>
                        <field name="order"/>
                        <field name="exercise_id"/>
                        <field name="exercise_type"/>
                        <field name="repetition_unit_id"/>
                        <field name="repetition_rounding"/>
                        <field name="weight_unit_id"/>
                        <field name="weight_rounding"/>
                        <field name="class_name"/>
                    </group>
                    <field name="comment"/>
                    <field name="config"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_slot_entry" model="ir.actions.act_window">
        <field name="name">Workout Plan Entries</field>
        <field name="res_model">fitness.slot.entry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
