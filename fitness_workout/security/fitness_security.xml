    <record id="rule_fitness_plan_v2_activity_user_access" model="ir.rule">
        <field name="name">Workout Plan V2 Activity User Access</field>
        <field name="model_id" ref="model_fitness_plan_v2_activity"/>
        <field name="groups" eval="[(4, ref('fitness_workout.group_workout_user'))]"/>
        <field name="domain_force">['|', '&amp;', ('plan_id.plan_scope', '=', 'template'), ('plan_id.is_public', '=', True), '&amp;', ('plan_id.plan_scope', '=', 'user'), ('plan_id.partner_id', '=', user.partner_id.id)]</field>
