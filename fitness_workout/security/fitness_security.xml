    </record>

    <record id="rule_fitness_workout_entry_trainer_manager_all" model="ir.rule">
        <field name="name">Workout Entry Trainer Manager All</field>
        <field name="model_id" ref="model_fitness_workout_entry"/>
        <field name="groups" eval="[(4, ref('fitness_workout.group_workout_trainer')), (4, ref('fitness_workout.group_workout_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_fitness_workout_card_user_access" model="ir.rule">
