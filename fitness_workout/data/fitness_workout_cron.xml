<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_import_wger_exercises" model="ir.actions.server">
        <field name="name">Import WGER Exercises</field>
        <field name="model_id" ref="model_fitness_exercise"/>
        <field name="state">code</field>
        <field name="code">action = model.action_import_wger_exercises(limit=200, sync_images=True)</field>
    </record>

    <record id="ir_cron_fitness_sync_wger_images" model="ir.cron">
        <field name="name">Workout: Sync WGER exercise images</field>
        <field name="model_id" ref="model_fitness_exercise"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_wger_images_batch(limit=100)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
