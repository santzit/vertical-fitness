<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_dashboard_fitness_members" model="spreadsheet.dashboard">
        <field name="name">Members</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="fitness_membership_dashboard/data/files/members_dashboard.json"
        />
        <field
            name="sample_dashboard_file_path"
        >fitness_membership_dashboard/data/files/members_dashboard.json</field>
        <field name="main_data_model_ids" eval="[(4, ref('base.model_res_partner')), (4, ref('account.model_account_move'))]"/>
        <field name="dashboard_group_id" ref="fitness_membership_dashboard.spreadsheet_dashboard_group_members"/>
        <field
            name="group_ids"
            eval="[Command.link(ref('fitness_workout.group_workout_trainer')), Command.link(ref('fitness_workout.group_workout_manager'))]"
        />
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>
</odoo>
